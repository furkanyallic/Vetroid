<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- Location Permissions for Geofence -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Do Not Disturb Permission (Sessiz Mod için) -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- Exact Alarm Permissions -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Background Location (for Geofence) -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Boot Completed (alarmları yeniden kurmak için) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Ağ durumu kontrolü için (constraint checker) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Wi-Fi kontrolü için -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- Bluetooth kontrolü için (API < 31) -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- Bluetooth kontrolü için (API >= 31) -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Parlaklık kontrolü için (kullanıcının özel ayardan izin vermesi gerekir) -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />

    <!-- SMS Permission -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!-- Contacts Permission -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- App Usage Stats (Uygulama tetikleyicisi için) -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Foreground Service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Bildirim gösterimi (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Titreşim (Shake geri bildirimi) -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Uygulama kapatma -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Vetroid"
        tools:targetApi="35">

        <!-- Google Maps API Key (Replace with your actual key) -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyC4ZFb6D12OdsnJsippVhah2BqIW8ioTV0" />

        <activity
            android:name=".ConstraintsActivity"
            android:exported="false" />
        <activity
            android:name=".ActionsActivity"
            android:exported="false" />
        <activity
            android:name=".TriggersActivity"
            android:exported="false" />
        <activity
            android:name=".AddMacroActivity"
            android:exported="false" />
        <activity
            android:name=".GeofenceSetupActivity"
            android:exported="false" />
        <activity
            android:name=".ActionSetupActivity"
            android:exported="false" />
        <activity
            android:name=".TimeSetupActivity"
            android:exported="false" />
        <activity
            android:name=".AppActionSetupActivity"
            android:exported="false" />
        <activity
            android:name=".WifiBluetoothSetupActivity"
            android:exported="false" />
        <activity
            android:name=".BrightnessActionSetupActivity"
            android:exported="false" />
        <activity
            android:name=".AppPickerActivity"
            android:exported="false" />
        <activity
            android:name=".NotificationActionSetupActivity"
            android:exported="false" />
        <activity
            android:name=".SmsActionSetupActivity"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Geofence BroadcastReceiver -->
        <receiver
            android:name=".receiver.GeofenceBroadcastReceiver"
            android:exported="true" />

        <!-- Time Trigger BroadcastReceiver -->
        <receiver
            android:name=".receiver.TimeTriggerReceiver"
            android:exported="true" />

        <!-- Boot Receiver — telefon yeniden başlatıldığında alarmları geri yükler -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- System Event Receiver — pil, şarj ve kulaklık olaylarını dinler -->
        <receiver
            android:name=".receiver.SystemEventReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
                <action android:name="android.intent.action.BATTERY_LOW" />
                <action android:name="android.intent.action.HEADSET_PLUG" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".BatteryTriggerSetupActivity"
            android:exported="false" />
        <activity
            android:name=".TimeWindowConstraintSetupActivity"
            android:exported="false" />
        <activity
            android:name=".WifiConstraintSetupActivity"
            android:exported="false" />
        <activity
            android:name=".ChargingConstraintSetupActivity"
            android:exported="false" />
        <activity
            android:name=".AppTriggerSetupActivity"
            android:exported="false" />

        <activity
            android:name=".ShakeTriggerSetupActivity"
            android:exported="false" />

        <activity
            android:name=".ScreenshotActionSetupActivity"
            android:exported="false" />

        <!-- Uygulama tetikleyici arka plan servisi -->
        <service
            android:name=".AppMonitorService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!-- Sallama tetikleyici servisi -->
        <service
            android:name=".ShakeDetectorService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!-- Ekran görüntüsü için erişilebilirlik servisi -->
        <service
            android:name=".VetroidAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService"/>
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config"/>
        </service>

    </application>

</manifest>
